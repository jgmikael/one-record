# One Record Demo - Environment Configuration

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_PATH=apps/api/data/one-record.db
SEED_DB=false

# Logging
LOG_LEVEL=info

# CORS Configuration (comma-separated origins)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API Configuration
# API_BASE_URL=http://localhost:3001/api

# Optional: External SAP Integration (future)
# SAP_HOST=
# SAP_PORT=
# SAP_CLIENT=
# SAP_USER=
# SAP_PASSWORD=

# Optional: Seller Master Data Service (future)
# SELLER_DATA_API_URL=
# SELLER_DATA_API_KEY=

# Optional: W3C VC Configuration (future)
# DID_METHOD=key
# DID_RESOLVER_URL=
# VC_ISSUER_DID=
# VC_SIGNING_KEY_PATH=

# Optional: Performance Tuning
# MAX_REQUEST_SIZE=10mb
# REQUEST_TIMEOUT_MS=30000

# Optional: Security (production)
# API_KEY_HEADER=X-API-Key
# API_KEY=
# JWT_SECRET=
# JWT_EXPIRY=24h

# Optional: Monitoring
# SENTRY_DSN=
# PROMETHEUS_PORT=9090
