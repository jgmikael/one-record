{
  "name": "one-record-demo",
  "version": "1.0.0",
  "description": "SAP Order to fcior-aligned One Record Canonical transformation demo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "install": "npm install --workspaces",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=@one-record/api",
    "dev": "npm run dev --workspace=@one-record/api",
    "test": "npm run test --workspaces --if-present",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist apps/*/node_modules apps/*/dist",
    "setup": "npm install && npm run build",
    "demo": "npm run setup && npm start"
  },
  "keywords": [
    "one-record",
    "fcior",
    "sap",
    "transformation",
    "json-ld",
    "verifiable-credentials",
    "semantic-interoperability"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.4"
  }
}
